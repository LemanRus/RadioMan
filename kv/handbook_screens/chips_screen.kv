#:import Clock kivy.clock.Clock

<ChipsScreen>:
    name: "chips_screen"

    MDBackTopBar:
        id: chips_top_bar

        MDWhiteTopAppBarTitle:
            text: "Микросхемы и компоненты"

    ScrollView:
        size_hint_y: (root.height - sp(60)) / root.height
        pos_hint: {"top": (root.height - chips_top_bar.height) / root.height}

        MDPaddedList:

            MDIconCard:
                on_release: root.manager.current = "chips_analogs_select_screen"

                ImageButton:
                    source: "media/chips_analogs.webp"
                    on_release: root.manager.current = "chips_analogs_select_screen"

                MDShortenLabel:
                    text: "Аналоги отечественных микросхем"

<ChipsAnalogsSelectScreen>:
    name: "chips_analogs_select_screen"

    MDBackTopBar:
        id: chips_analogs_select_top_bar

        MDWhiteTopAppBarTitle:
            text: "Аналоги отечественных микросхем"

    # Контент - скрывается во время загрузки
    ScrollView:
        id: content_scroll_view
        size_hint_y: (root.height - sp(60)) / root.height
        pos_hint: {"top": (root.height - chips_analogs_select_top_bar.height) / root.height}
        opacity: 0
        disabled: True

        MDPaddedList:
            id: chips_analogs_list
            # Карточки будут создаваться динамически в Python коде через on_enter

    # Спиннер загрузки - показывается поверх всего экрана
    AnchorLayout:
        id: loading_overlay
        anchor_x: "center"
        anchor_y: "center"
        size_hint: 1, 1
        pos_hint: {"x": 0, "y": 0, "top": 1, "right": 1}
        md_bg_color: [1, 1, 1, 1] if app.theme_cls.theme_style == "Light" else [0.1, 0.1, 0.1, 1]
        
        MDCircularProgressIndicator:
            size_hint: None, None
            size: dp(50), dp(50)
            determinate: False
            active: True
            line_width: dp(3)
            rotation_duration: 1.0

<ChipsAnalogsScreen>:
    name: "chips_analogs_screen"

    MDBackTopBar:
        id: chips_analogs_top_bar

        MDWhiteTopAppBarTitle:
            id: chips_analogs_top_bar_title
            text: "Test"

    # Контент - скрывается во время загрузки
    ScrollView:
        id: chips_analogs_scroll_view
        size_hint_y: (root.height - sp(60)) / root.height
        pos_hint: {"top": (root.height - chips_analogs_top_bar.height) / root.height}
        do_scroll_x: False
        opacity: 0
        disabled: True

        ChipsAnalogs:
            id: chips_analogs

    # Спиннер загрузки - показывается поверх всего экрана
    AnchorLayout:
        id: loading_overlay
        anchor_x: "center"
        anchor_y: "center"
        size_hint: 1, 1
        pos_hint: {"x": 0, "y": 0, "top": 1, "right": 1}
        md_bg_color: [1, 1, 1, 1] if app.theme_cls.theme_style == "Light" else [0.1, 0.1, 0.1, 1]
        
        MDCircularProgressIndicator:
            size_hint: None, None
            size: dp(50), dp(50)
            determinate: False
            active: True
            line_width: dp(3)
            rotation_duration: 1.0